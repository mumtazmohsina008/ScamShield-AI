# Server Port
PORT=5000

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Configurable Gemini Model (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173

# Demo Mode: if set to true, uses built-in realistic AI simulation when API key is missing
DEMO_MODE=false
